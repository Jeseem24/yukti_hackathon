# Backend Environment Variables
# Copy this to .env and fill in your values
# DO NOT commit .env to git (it contains secrets)

# Groq API key — get yours free at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the data path (leave blank to use auto-detection)
# ANOMALY_DATA_PATH=../modeling/anomaly_scores.parquet
